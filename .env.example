# Server-side AI provider configuration for the website assistant.
# Copy to .env for local Node tooling, or set these in the hosting dashboard.
# Never commit a filled .env file.
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: receives a JSON record for every feedback submission.
ASSISTANT_FEEDBACK_WEBHOOK_URL=
